<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The simulation and the skirmish AI, with no engine code in them.
    .NET Standard 2.1 and C# 9 are what Unity 6 and Godot 4 (.NET) both accept.
    The arithmetic relies on 32-bit numbers wrapping round, so overflow checking
    must stay off (which is the default).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Rts</RootNamespace>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
