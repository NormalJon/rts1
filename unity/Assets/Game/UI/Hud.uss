/* How the display over the battlefield looks. Laid out by Runtime/Hud.cs,
   after the browser version's page (src/client/game/page.html): dark glass
   panels floating over the corners of the field, the same colours and sizes. */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 12px 16px;
    flex-direction: column;
    justify-content: space-between;
}

/* ---- Words ---------------------------------------------------------------- */

.t {
    margin: 0;
    padding: 0;
    color: #e7ece4;
    font-size: 14px;
    white-space: nowrap;
}

.small { font-size: 12px; }
.muted { color: #9ba89e; }
.warn { color: #f0a868; }
.h1 { font-size: 17px; -unity-font-style: bold; margin-right: 14px; }
.h2 { font-size: 15px; -unity-font-style: bold; margin-bottom: 8px; }

.kbd {
    font-size: 11px;
    color: #9ba89e;
    border-width: 1px;
    border-color: #35433c;
    border-radius: 3px;
    padding: 0 4px;
    margin-left: 7px;
}

/* ---- Panels and buttons --------------------------------------------------- */

.panel {
    background-color: rgba(18, 25, 22, 0.86);
    border-width: 1px;
    border-color: #35433c;
    border-radius: 6px;
}

.btn {
    background-color: rgba(18, 25, 22, 0.86);
    border-width: 1px;
    border-color: #35433c;
    border-radius: 6px;
    padding: 7px 12px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.btn:hover { border-color: #9ba89e; }
.btn:active { background-color: rgba(52, 66, 59, 0.92); }
.pressed { border-color: #8cc0ea; }
.pressed .t { color: #8cc0ea; }

/* ---- The top row ---------------------------------------------------------- */

.top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.title { align-items: flex-start; max-width: 560px; flex-shrink: 0; }
.title-card { padding: 8px 12px; }
.title-row { flex-direction: row; align-items: center; justify-content: space-between; }
.stats { font-size: 11px; color: #9ba89e; margin-top: 3px; }
.level { flex-direction: row; align-items: center; }
.level-choice { padding: 2px 8px; margin-left: 5px; }

.production { margin-top: 8px; align-items: flex-start; }
.producing { padding: 5px 11px 8px 11px; margin-bottom: 5px; overflow: hidden; }
.producing-bar { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background-color: #8cc0ea; }

.stores { flex-direction: row; align-items: center; padding: 7px 5px; flex-shrink: 0; }
.store { flex-direction: row; align-items: center; margin: 0 9px; }
.store .muted { margin-right: 7px; }
.store-age { padding-right: 14px; margin-right: 5px; border-right-width: 1px; border-color: #35433c; }
.age { -unity-font-style: bold; color: #8cc0ea; }

.right { align-items: flex-end; flex-shrink: 0; }
.tools { flex-direction: row; }
.tool { margin-left: 8px; }

.help { margin-top: 12px; padding: 12px 6px 12px 14px; width: 330px; max-height: 660px; }
.help-scroll { flex-shrink: 1; }
/* The bar the list is scrolled by: a thin dark rail, without the arrows at its ends. */
.help-scroll .unity-scroller--vertical { width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.help-scroll .unity-scroller--vertical .unity-scroller__low-button { display: none; }
.help-scroll .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.help-scroll .unity-scroller--vertical .unity-scroller__slider { margin-top: 0; margin-bottom: 0; width: 8px; }
.help-scroll .unity-scroller--vertical .unity-scroller__slider .unity-base-slider__tracker { background-color: rgba(53, 67, 60, 0.55); border-width: 0; border-radius: 4px; }
.help-scroll .unity-scroller--vertical .unity-scroller__slider .unity-base-slider__dragger { background-color: #6f7d73; border-width: 0; border-radius: 4px; width: 8px; left: 0; }
.help-scroll .unity-scroller--vertical .unity-scroller__slider .unity-base-slider__dragger-border { border-width: 0; background-color: rgba(0, 0, 0, 0); }

.help-row { flex-direction: row; margin-bottom: 6px; margin-right: 8px; }
.help-keys { width: 98px; flex-shrink: 0; font-size: 11.5px; color: #8cc0ea; }
.help-what { flex-grow: 1; flex-shrink: 1; flex-basis: 0; font-size: 13px; white-space: normal; }
.help-text { margin-top: 10px; margin-right: 8px; font-size: 12.5px; white-space: normal; }

/* ---- The bottom row ------------------------------------------------------- */

.bottom { flex-direction: row; align-items: flex-end; }

.map { padding: 5px; flex-shrink: 0; }
.minimap { width: 200px; height: 200px; overflow: hidden; }
.minimap-lines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.bar { flex-grow: 1; flex-shrink: 1; align-items: center; margin-left: 12px; }
.above { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; margin-bottom: 8px; }
.groups { flex-direction: row; }
.idle { padding: 4px 10px; border-color: #8cc0ea; margin: 0 3px; }
.group-chip { padding: 3px 9px 3px 4px; margin: 0 3px; }
.group-digit {
    background-color: #8cc0ea;
    color: #0c1620;
    border-radius: 3px;
    min-width: 20px;
    padding: 1px 3px;
    margin-right: 7px;
    -unity-text-align: middle-center;
}

.command { padding: 8px 10px 9px 14px; width: 780px; max-width: 100%; }
.command-head { flex-direction: row; align-items: center; justify-content: space-between; min-height: 30px; }
.selection { flex-grow: 1; flex-shrink: 1; flex-basis: 0; white-space: normal; margin-right: 14px; }
.orders { flex-direction: row; flex-shrink: 0; }
.order { background-color: rgba(0, 0, 0, 0); padding: 5px 9px; margin-left: 6px; }

.progress { height: 5px; border-radius: 3px; background-color: #35433c; overflow: hidden; margin-top: 8px; }
.progress-bar { height: 100%; width: 0; background-color: #8cc0ea; }

.queue { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.queued { background-color: rgba(0, 0, 0, 0); padding: 3px 9px; margin-right: 6px; border-color: #2c3832; }
.queued--first { border-color: #8cc0ea; }

.actions { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.action { background-color: rgba(0, 0, 0, 0); padding: 6px 9px; margin: 0 6px 6px 0; }
.action-face { flex-direction: column; }
.action-name { -unity-font-style: bold; }
.action-detail { color: #9ba89e; font-size: 11.5px; }
.action--short .action-name { color: #f0a868; }
.action--short .action-detail { color: #f0a868; }
.action--quiet .action-name { -unity-font-style: normal; color: #9ba89e; }
.action--locked { border-color: #2c3832; }
.action--locked .action-name { color: #9ba89e; }
.action--locked .action-detail { color: #9ba89e; }

/* ---- Over everything ------------------------------------------------------ */

.float { position: absolute; left: 0; right: 0; align-items: center; }
.float-toast { top: 68px; }
.float-banner { top: 30%; }

.toast { padding: 7px 14px; border-color: #f0a868; max-width: 560px; }
.toast .t { white-space: normal; -unity-text-align: middle-center; }

.banner { padding: 18px 30px; align-items: center; }
.banner-title { font-size: 27px; -unity-font-style: bold; }

.select-box {
    position: absolute;
    border-width: 1px;
    border-color: #f4f1e4;
    background-color: rgba(244, 241, 228, 0.12);
}

.tip {
    position: absolute;
    max-width: 370px;
    white-space: normal;
    padding: 7px 10px;
    font-size: 12.5px;
    background-color: rgba(18, 25, 22, 0.97);
    border-width: 1px;
    border-color: #35433c;
    border-radius: 6px;
}
